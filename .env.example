# Copy to .env as it is: these values work for the local Docker stack on your own machine.
# Every port is bound to 127.0.0.1, so the passwords below never leave your computer.
# Use new passwords for anything reachable from the internet. .env is ignored by git.

# Database owner, used by docker compose and by `python -m src.data.load_db`.
POSTGRES_USER=owner
POSTGRES_PASSWORD=local-owner-pass
POSTGRES_DB=energy
# Host port of the compose database; change it (and DATABASE_URL) when a local Postgres uses 5432.
DB_PORT=5432

# Team roles created by load_db (passwords need 12+ characters).
DB_TEAM_USER=team
DB_TEAM_PASSWORD=local-team-pass
DB_READER_USER=reader
DB_READER_PASSWORD=local-reader-pass

# Connection used by commands you run on your machine (load_db, train --publish, replay).
DATABASE_URL=postgresql://owner:local-owner-pass@localhost:5432/energy

# Dashboard admin created on first start; sign in with these at http://localhost:5173.
DEMO_ADMIN_EMAIL=admin@enerji.local
DEMO_ADMIN_PASSWORD=admin-demo-pass

# Session cookie; set COOKIE_SECURE=true once the API is served over HTTPS.
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=

# Optional: Claude writes a short Turkish advice for each finished live event (paid per use,
# at most 10 events per scoring cycle). Leave empty to keep only the built-in explanations.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

# Default electricity tariff for cost estimates (TL/kWh); each meter can override it.
TARIFF_TL_PER_KWH=3.5

# Location used when a meter is registered without coordinates (Istanbul).
DEFAULT_LAT=41.0082
DEFAULT_LNG=28.9784
DEFAULT_TIMEZONE=Europe/Istanbul

# Optional paths.
# DATA_DIR=data
# REPORTS_DIR=reports
# MODEL_DIR=models_out
# MLFLOW_DIR=mlruns
# MLFLOW_TRACKING_URI=http://localhost:5000
