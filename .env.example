# Copy to .env and fill in. .env is ignored by git; never commit real values.

# Database owner, used by docker compose and by `python -m src.data.load_db`.
POSTGRES_USER=owner
POSTGRES_PASSWORD=
POSTGRES_DB=energy

# Team roles created by load_db (passwords need 12+ characters).
DB_TEAM_USER=team
DB_TEAM_PASSWORD=
DB_READER_USER=reader
DB_READER_PASSWORD=

# Local connection: owner for load_db, team for imports and scoring, reader for analysis.
DATABASE_URL=postgresql://owner:CHANGE_ME@localhost:5432/energy

# API write endpoints (register, import, feedback) need this key in X-API-Key.
API_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=

# Telegram alerts from the scoring service; leave empty to turn them off.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Default electricity tariff for cost estimates (TL/kWh); buildings can override it.
TARIFF_TL_PER_KWH=3.5

# Location used when a building is registered without coordinates (Istanbul).
DEFAULT_LAT=41.0082
DEFAULT_LNG=28.9784
DEFAULT_TIMEZONE=Europe/Istanbul

# Optional paths.
# DATA_DIR=data
# REPORTS_DIR=reports
# MODEL_DIR=models_out
# MLFLOW_DIR=mlruns
# MLFLOW_TRACKING_URI=http://localhost:5000
